# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: Anthropic API key enables live AI (tutor chat, extra practice, debate arena, insights).
# Without it, BOLT runs every AI feature with built-in demo responses.
VITE_ANTHROPIC_API_KEY=
