# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Anthropic API key: set ANTHROPIC_API_KEY (no VITE_ prefix!) as a Secret in Vercel env vars.
# It is only read by the server function api/ai.js and never shipped to the browser.
# Without it, BOLT runs every AI feature with built-in demo responses.
# Set VITE_AI_ENABLED=false to force demo mode locally.
# ANTHROPIC_API_KEY=   (server only)
